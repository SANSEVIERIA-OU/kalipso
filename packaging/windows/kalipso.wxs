<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-or-later
     The Windows installer, built by tools/make-msi.sh with msitools' wixl from the portable folder that
     the "macOS and Windows" workflow builds. The UpgradeCode never changes: each new version replaces the
     installed one in place. Scripts and settings live in the user's AppData and are kept. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Kalipso" Language="1033" Version="$(var.Version)" Manufacturer="Kalipso contributors"
           UpgradeCode="244E5789-7C34-4C1F-982C-531FC1158B34">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="Kalipso $(var.Version)" Comments="Teleprompter that follows your voice, on your device"/>
    <Media Id="1" Cabinet="kalipso.cab" EmbedCab="yes"/>
    <MajorUpgrade DowngradeErrorMessage="A newer version of Kalipso is already installed."/>

    <Icon Id="kalipso.ico" SourceFile="$(var.Icon)"/>
    <Property Id="ARPPRODUCTICON" Value="kalipso.ico"/>
    <Property Id="ARPURLINFOABOUT" Value="https://sansevieria-ou.github.io/kalipso/"/>
    <Property Id="ARPHELPLINK" Value="https://github.com/SANSEVIERIA-OU/kalipso/issues"/>
    <Property Id="ARPCOMMENTS" Value="Teleprompter that follows your voice, on your device"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Kalipso"/>
      </Directory>
      <Directory Id="ProgramMenuFolder"/>
    </Directory>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="92A2BB7E-DA29-44A7-9F6A-BEDFCC0F4208" Win64="yes">
        <Shortcut Id="KalipsoShortcut" Name="Kalipso" Description="Teleprompter that follows your voice"
                  Target="[INSTALLDIR]bin\kalipso.exe" WorkingDirectory="INSTALLDIR" Icon="kalipso.ico"/>
        <RegistryValue Root="HKLM" Key="Software\Kalipso" Name="StartMenuShortcut" Type="integer" Value="1"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Title="Kalipso" Level="1">
      <ComponentGroupRef Id="AppFiles"/>
      <ComponentRef Id="StartMenuShortcut"/>
    </Feature>

    <!-- A welcome page with the licence to accept (License.rtf, written by make-msi.sh), then the
         installation. -->
    <UIRef Id="WixUI_Minimal"/>
  </Product>
</Wix>
