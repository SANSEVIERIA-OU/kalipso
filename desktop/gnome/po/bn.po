msgstr "%s-এর ডাউনলোড তার ডিজিটাল ছাপের সঙ্গে মেলেনি, তাই মুছে ফেলা হয়েছে। পরে চেষ্টা করুন।"

msgid "The %s model couldn't be unpacked. Try again later."
msgstr "%s মডেল নিষ্কাশন করা যায়নি। পরে চেষ্টা করুন।"

msgid "The microphone turns on when you start"
msgstr "শুরু করলে মাইক্রোফোন চালু হয়"

msgid "The words advance at the speed below."
msgstr "নিচের গতিতে শব্দ এগিয়ে চলে।"

msgid "This Kalipso companion cannot download languages. Install or update it, then log out and back in."
msgstr "এই Kalipso সহায়ক ভাষা ডাউনলোড করতে পারে না। ইনস্টল বা হালনাগাদ করুন, তারপর লগ আউট করে আবার ঢুকুন।"

msgid "To take the colors of a window behind the reader, choose Follow a window's colors… in the reader's ⋯ menu."
msgstr "পাঠ-জানালার পেছনের জানালা থেকে রঙ নিতে পাঠ-জানালার ⋯ মেনুতে জানালার রঙ অনুসরণ করুন… বাছুন।"

msgid "Try again"
msgstr "আবার চেষ্টা করুন"

msgid "Use this language"
msgstr "এই ভাষা ব্যবহার করুন"

msgid "Vertical"
msgstr "উল্লম্ব"

msgid "Voice"
msgstr "কণ্ঠ"

msgid "Wide"
msgstr "প্রশস্ত"

msgid "Window colors unavailable. Install or update the Kalipso companion and the desktop sharing portal."
msgstr "জানালার রঙ পাওয়া যাচ্ছে না। Kalipso সহায়ক ও ডেস্কটপ ভাগের পোর্টাল ইনস্টল বা হালনাগাদ করুন।"

msgid "Window sharing stopped · Choose a background window to resume"
msgstr "জানালা ভাগ থেমেছে · আবার শুরু করতে পেছনের জানালা বাছুন"

msgid "You step with the keys, a pedal or a clicker."
msgstr "কি, প্যাডেল বা ক্লিকার দিয়ে ধাপে এগোন।"

msgid "your language"
msgstr "আপনার ভাষা"

